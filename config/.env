# ============================================================================
# smmt-internal-tooling — environment variables
# Fill in your real credentials, then run:  make config
# Do NOT commit real secrets. Add  envs/.env  to .gitignore.
# Empty values disable nothing automatically — but the server will fail to auth
# until filled. Remove a server block from config/all.services.json to skip it.
# ============================================================================

# --- Apollo  (Chainscore apollo-io-mcp; clone + npm run build first) ---------
# Absolute path to the built server entrypoint:
APOLLO_MCP_PATH=/ABSOLUTE/PATH/TO/apollo-io-mcp/dist/index.js
# Apollo > Settings > Integrations > Apollo API > API Keys:
APOLLO_API_KEY=

# --- HubSpot  (shinzo-labs) --------------------------------------------------
# Settings > Integrations > Private Apps > Auth tab  (looks like pat-na1-...):
HUBSPOT_ACCESS_TOKEN=

# --- LinkedIn  (stickerdaniel linkedin-scraper-mcp) --------------------------
# li_at session cookie. Get it with:  uvx linkedin-scraper-mcp --get-cookie
# Keep the li_at= prefix, e.g. LINKEDIN_COOKIE=li_at=AQED...
LINKEDIN_COOKIE=li_at=

# --- Upwork  (chinchilla API; or swap to a browser server, see README) -------
# OAuth2 access token from developers.upwork.com (approval required):
UPWORK_ACCESS_TOKEN=

# --- Google Drive  (isaacphi/mcp-gdrive) -------------------------------------
# Google Cloud OAuth (Desktop client). CREDS_DIR must contain gcp-oauth.keys.json:
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_CREDS_DIR=/Users/YOUR_USERNAME/.config/mcp-gdrive

# --- Gmail  (GongRzhe) -------------------------------------------------------
# No variables needed. Run once:  make auth-gmail   (browser OAuth -> ~/.gmail-mcp/)

# --- Meta Ads / Facebook + Instagram  (mikusnuz) -----------------------------
# Meta App (Business) > Marketing API > System User token (ads_management):
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=

# --- X / Twitter  (enescinar; ORGANIC posting/search only) -------------------
# X Developer Portal, OAuth 1.0a (Basic tier ~$200/mo):
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- YouTube content  (ZubeidHendricks) --------------------------------------
# Google Cloud > YouTube Data API v3 > API key:
YOUTUBE_API_KEY=

# --- YouTube Ads / Google Ads  (official MCP, READ-ONLY) ---------------------
# Google Ads API Center developer token + GCP project id:
GOOGLE_PROJECT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
